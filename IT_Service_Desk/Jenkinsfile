pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Test') {
            steps {
                sh '''
                    docker run --rm \
                    -v "$WORKSPACE/IT_Service_Desk:/app" \
                    -w /app \
                    -e DB_HOST=localhost \
                    -e DB_PORT=3306 \
                    -e DB_USER=ci \
                    -e DB_PASSWORD=ci \
                    -e DB_NAME=IT_S \
                    -e SECRET_KEY=test-secret \
                    -e JWT_SECRET_KEY=test-jwt-secret \
                    -e JWT_EXPIRES_MINUTES=15 \
                    -e JWT_COOKIE_SECURE=0 \
                    python:3.13-slim \
                    sh -c "pip install -r requirements.txt && pytest"
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('IT_Service_Desk') {
                    sh 'docker build -t prabhushriyaans/flask-app:latest .'
                }
            }
        }

        stage('Push to Docker Hub') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-cred',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {
                    sh '''
                        echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
                        docker push prabhushriyaans/flask-app:latest
                    '''
                }
            }
        }
    }
}